{
  "description": "Ten helical-displacement seeds (0-9) at fixed Gaussian density seed 0 and fixed ZA displacement. L=1000, 256^3 field mesh, 32^3 lattice particles; reuse compatible field components from the four-seed pilot. Uncertainties are conditional on this one initial density.",
  "purpose": "technical_pilot",
  "field": {
    "model": "mesh_za_helical", "amplitude_convention": "rms",
    "L": 1000.0, "N": 256, "particle_grid": 32, "Ngal": 32768,
    "density_seed": 0,
    "sigma_delta": 0.2, "helical_smoothing": 6.25,
    "spectrum": {"kind": "power_law", "index": 0.0, "smoothing": 6.25},
    "exclude_nyquist": true, "tolerance": 1e-10
  },
  "null": {"seeds": 10, "A": 2.0, "include_original_L1_A1": false},
  "scan": {"seeds": 10, "amplitudes": [0.5, 2.0]},
  "positive": {"seeds": 0, "fractions": []},
  "save_tetrahedra": true,
  "scheduler": {
    "partition": "public-cpu", "cpus": 4, "memory": "48G", "time": "01:00:00",
    "concurrency": 2, "seeds_per_task": 1,
    "validate": {"partition": "public-cpu", "cpus": 4, "memory": "48G", "time": "00:30:00"},
    "summary": {"partition": "public-cpu", "cpus": 2, "memory": "4G", "time": "00:15:00"}
  }
}
